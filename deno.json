{
	"name": "@marianmeres/cli-status-line",
	"version": "0.2.0",
	"exports": "./src/mod.ts",
	"tasks": {
		"test": "deno test",
		"test:watch": "deno test --watch",
		"lint": "deno lint",
		"check": "deno check src/ tests/ scripts/ examples/",
		"release": "deno run -A jsr:@marianmeres/release",
		"publish": "deno publish",
		"rp": "deno task release -y && deno task publish",
		"rpm": "deno task release minor -y && deno task publish"
	},
	"imports": {
		"@marianmeres/cli-status-line": "./src/mod.ts",
		"@std/assert": "jsr:@std/assert@^1.0.19",
		"@std/cli": "jsr:@std/cli@^1.0.32",
		"@std/fmt": "jsr:@std/fmt@^1.0.10",
		"@std/testing": "jsr:@std/testing@^1.0.20"
	},
	"publish": {
		"exclude": [
			".*",
			"tests/**",
			"docs/**",
			"scripts/**",
			"examples/**",
			"tmp/**"
		]
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 90,
		"indentWidth": 4,
		"proseWrap": "preserve"
	}
}
