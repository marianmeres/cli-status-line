{
	"name": "@marianmeres/cli-status-line",
	"version": "0.1.0",
	"exports": "./src/mod.ts",
	"tasks": {
		"test": "deno test",
		"test:watch": "deno test --watch",
		"release": "deno run -A jsr:@marianmeres/release",
		"publish": "deno publish",
		"rp": "deno task release -y && deno task publish",
		"rpm": "deno task release minor -y && deno task publish"
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@^1.0.19",
		"@std/cli": "jsr:@std/cli@^1.0.32",
		"@std/fmt": "jsr:@std/fmt@^1.0.10",
		"@std/fs": "jsr:@std/fs@^1.0.24",
		"@std/path": "jsr:@std/path@^1.1.6"
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 90,
		"indentWidth": 4,
		"proseWrap": "preserve"
	}
}
