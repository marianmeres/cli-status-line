{
  "name": "@marianmeres/cli-status-line",
  "version": "0.2.0",
  "description": "Single-line, tick-only CLI status renderer with a plain-text fallback for redirected output.",
  "license": "MIT",
  "author": "Marian Meres",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@marianmeres/source": "./src/mod.ts",
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    }
  },
  "files": [
    "dist",
    "API.md",
    "AGENTS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marianmeres/cli-status-line.git"
  },
  "bugs": {
    "url": "https://github.com/marianmeres/cli-status-line/issues"
  },
  "homepage": "https://github.com/marianmeres/cli-status-line#readme",
  "keywords": [
    "cli",
    "terminal",
    "status",
    "spinner",
    "progress",
    "tty"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "test:deno": "CHILD_RUNTIME=deno node --test tests/lifecycle.test.ts",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm test",
    "example": "node --conditions=@marianmeres/source",
    "prepublishOnly": "pnpm run ci && pnpm run build",
    "release": "npx --yes @marianmeres/release@^2.2.0",
    "publish:jsr": "pnpm run test:deno && deno publish --set-version \"$npm_package_version\"",
    "publish:all": "pnpm publish && pnpm run publish:jsr",
    "rp": "pnpm run release -y && pnpm run publish:all",
    "rpm": "pnpm run release minor -y && pnpm run publish:all"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
